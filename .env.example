# ============================================================
# Google Nest Wifi Pro Dashboard — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
#
# To obtain your GOOGLE_MASTER_TOKEN, run:
#   python auth_helper.py
#
# For detailed instructions, see the README.

# Your Google account email address
GOOGLE_EMAIL=your-email@gmail.com

# Master token obtained via auth_helper.py (starts with "aas_et/...")
GOOGLE_MASTER_TOKEN=

# Android device ID (hex string). Leave blank to auto-generate.
ANDROID_ID=

# IP address of your primary Nest Wifi Pro router
ROUTER_IP=192.168.86.1

# Port for the Flask web server
FLASK_PORT=5000

# How often (in seconds) to refresh cached data
REFRESH_INTERVAL=30

# Set to "true" to force demo mode even when credentials are present
FORCE_DEMO_MODE=false
